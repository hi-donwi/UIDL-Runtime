              "fontSize": "text-sm",
              "fontWeight": "font-semibold",
              "textColor": "{primitives.color.textPrimary}"
            }
          },
          {
            "id": "grid-pharm",
            "type": "DataTable",
            "props": {
              "data": "$data.pharmacyFefo",
              "columns": [
                {
                  "key": "itemCode",
                  "label": "Item Code"
                },
                {
                  "key": "medication",
                  "label": "Medication & Dosage"
                },
                {
                  "key": "batchNo",
                  "label": "Batch No."
                },
                {
                  "key": "expiryDate",
                  "label": "Expiration Date"
                },
                {
                  "key": "stock",
                  "label": "Physical Stock"
                },
                {
                  "key": "dispenseRule",
                  "label": "Dispense Rule"
                },
                {
                  "key": "status",
                  "label": "Inventory Status"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "table-claims-card",
        "type": "Card",
        "style": {
          "padding": "p-4",
          "backgroundColor": "{primitives.color.surface}"

        "children": [
          {
            "id": "kpi-rawat-jalan",
            "type": "Card",
            "style": {
              "flex": "1",
              "padding": "p-4",
              "backgroundColor": "{primitives.color.surface}"
            },
            "children": [
              {
                "id": "t-kpi-1",
                "type": "Text",
                "props": {
                  "text": "Outpatient Visits Today"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "{primitives.color.textSecondary}"

              {
                "id": "v-kpi-1",
                "type": "Text",
                "props": {
                  "text": "401 Patients"
                },
                "style": {
                  "fontSize": "text-xl",
                  "fontWeight": "font-bold",
                  "textColor": "{primitives.color.textPrimary}"

  "definitions": {
    "pageHeader": {
      "id": "header-tpl",
      "type": "Navbar",
      "style": {
        "justifyContent": "space-between",
        "padding": "p-4",
        "borderWidth": "border-b",
        "borderColor": "{primitives.color.border}"
      },
      "slots": {
        "title": [],
        "actions": []
      }
    }
  },
  "root": {
    "id": "hospital-console",
    "type": "Column",
    "style": {
      "gap": "gap-4",
      "padding": "p-4"
    },
    "children": [
      {
        "id": "hospital-header",
        "type": "Navbar",
        "componentId": "pageHeader",
        "slots": {
          "title": [
            {
              "id": "hospital-title",
              "type": "Text",
              "props": {
                "text": "Metro Health Medical Center — Hospital EMR & Clinical Console"
              },
              "style": {
                "fontSize": "text-lg",
                "fontWeight": "font-bold",
                "textColor": "{primitives.color.textPrimary}"
              }
            }
          ],
          "actions": [
            {
              "id": "btn-pendaftaran",
              "type": "Button",
              "props": {
                "label": "+ Register Patient",
                "variant": "primary"
              }
            },
            {
              "id": "btn-insurance",
              "type": "Button",
              "props": {
                "label": "Insurance Clearinghouse",
                "variant": "outline"
              }
            }
          ]
        }
      },
      {
        "id": "hospital-kpis",
        "type": "Row",
        "style": {
          "gap": "gap-4",
          "flexWrap": "flex-wrap"

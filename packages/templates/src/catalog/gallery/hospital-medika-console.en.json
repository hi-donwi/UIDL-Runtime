              "fontSize": "text-sm",
              "fontWeight": "font-semibold",
              "textColor": "{primitives.color.textPrimary}"
            }
          },
          {
            "id": "grid-queue",
            "type": "DataTable",
            "props": {
              "data": "$data.patientQueue",
              "columns": [
                {
                  "key": "ticketNo",
                  "label": "Queue No."
                },
                {
                  "key": "recordNo",
                  "label": "MRN"
                },
                {
                  "key": "patientName",
                  "label": "Patient Name"
                },
                {
                  "key": "department",
                  "label": "Department"
                },
                {
                  "key": "physician",
                  "label": "Attending Physician"
                },
                {
                  "key": "insurance",
                  "label": "Insurance Provider"
                },
                {
                  "key": "status",
                  "label": "Care Status"
                }
              ]
            }
          }
        ]

                  "fontSize": "text-sm",
                  "fontWeight": "font-semibold",
                  "textColor": "{primitives.color.textPrimary}"
                }
              },
              {
                "id": "c-chart-1",
                "type": "Chart",
                "props": {
                  "type": "bar",
                  "data": "$data.clinicVisits"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "table-patient-queue-card",
        "type": "Card",
        "style": {
          "padding": "p-4",
          "backgroundColor": "{primitives.color.surface}"

        "children": [
          {
            "id": "t-title-claims",
            "type": "Text",
            "props": {
              "text": "Healthcare Insurance Claims & DRG Settlement"
            },
            "style": {
              "fontSize": "text-sm",
              "fontWeight": "font-semibold",
              "textColor": "{primitives.color.textPrimary}"
            }
          },
          {
            "id": "grid-claims",
            "type": "DataTable",
            "props": {
              "data": "$data.insuranceClaims",
              "columns": [
                {
                  "key": "claimId",
                  "label": "Claim ID"
                },
                {
                  "key": "patient",
                  "label": "Patient Name"
                },
                {
                  "key": "diagnosis",
                  "label": "ICD-10 Diagnosis"
                },
                {
                  "key": "amount",
                  "label": "Settlement Amount"
                },
                {
                  "key": "verificationStatus",
                  "label": "Adjudication Status"
                },
                {
                  "key": "submissionDate",
                  "label": "Service Date"
                }
              ]
            }
          }
        ]
      }

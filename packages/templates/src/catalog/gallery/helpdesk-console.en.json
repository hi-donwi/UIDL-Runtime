        "category": "Account Security",
        "usage": "210 times",
        "effectivenessRating": "99%"
      }
    ]
  },
  "definitions": {
    "pageHeader": {
      "id": "header-tpl",
      "type": "Navbar",
      "style": {
        "justifyContent": "space-between",
        "padding": "p-4",
        "borderWidth": "border-b",
        "borderColor": "{primitives.color.border}"
      },
      "slots": {
        "title": [],
        "actions": []
      }
    }
  },
  "root": {
    "id": "helpdesk-root",
    "type": "Column",
    "style": {
      "gap": "gap-4",
      "padding": "p-4"
    },
    "children": [
      {
        "id": "helpdesk-header",
        "type": "Navbar",
        "componentId": "pageHeader",
        "slots": {
          "title": [
            {
              "id": "helpdesk-title",
              "type": "Text",
              "props": {
                "text": "CloudDesk Support Center — Customer Help Desk & SLA Hub"
              },
              "style": {
                "fontSize": "text-lg",
                "fontWeight": "font-bold",
                "textColor": "{primitives.color.textPrimary}"
              }
            }
          ],
          "actions": [
            {
              "id": "btn-new-ticket",
              "type": "Button",
              "props": {
                "label": "+ Create New Ticket",
                "variant": "primary"
              }
            },
            {
              "id": "btn-kb-center",
              "type": "Button",
              "props": {
                "label": "Knowledge Base & Canned",
                "variant": "outline"
              }
            }
          ]
        }
      },
      {
        "id": "helpdesk-kpis",
        "type": "Row",
        "style": {
          "gap": "gap-4",
          "flexWrap": "flex-wrap"
        },
        "children": [
          {
            "id": "kpi-open-tickets",
            "type": "Card",
            "style": {
              "flex": "1",
              "padding": "p-4",
              "backgroundColor": "{primitives.color.surface}"
            },
            "children": [
              {
                "id": "t-kpi-1",
                "type": "Text",
                "props": {
                  "text": "Open Active Tickets"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "{primitives.color.textSecondary}"
                }
              },
              {
                "id": "v-kpi-1",
                "type": "Text",
                "props": {
                  "text": "28 Tickets"
                },
                "style": {
                  "fontSize": "text-xl",
                  "fontWeight": "font-bold",
                  "textColor": "{primitives.color.textPrimary}"
                }
              },
              {
                "id": "s-kpi-1",
                "type": "Text",
                "props": {
                  "text": "4 Urgent Priority Tickets"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "#dc2626"
                }
              }
            ]
          },
          {
            "id": "kpi-first-response-sla",
            "type": "Card",
            "style": {
              "flex": "1",
              "padding": "p-4",
              "backgroundColor": "{primitives.color.surface}"
            },
            "children": [
              {
                "id": "t-kpi-2",
                "type": "Text",
                "props": {
                  "text": "First Response Time (SLA)"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "{primitives.color.textSecondary}"
                }
              },
              {
                "id": "v-kpi-2",
                "type": "Text",
                "props": {
                  "text": "14 Minutes"
                },
                "style": {
                  "fontSize": "text-xl",
                  "fontWeight": "font-bold",
                  "textColor": "#059669"
                }
              },
              {
                "id": "s-kpi-2",
                "type": "Text",
                "props": {
                  "text": "Target < 30 Min (99.4% SLA Met)"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "#059669"
                }
              }
            ]
          },
          {
            "id": "kpi-resolution-rate",
            "type": "Card",
            "style": {
              "flex": "1",
              "padding": "p-4",
              "backgroundColor": "{primitives.color.surface}"
            },
            "children": [
              {
                "id": "t-kpi-3",
                "type": "Text",
                "props": {
                  "text": "First Contact Resolution"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "{primitives.color.textSecondary}"
                }
              },
              {
                "id": "v-kpi-3",
                "type": "Text",
                "props": {
                  "text": "78.5%"
                },
                "style": {
                  "fontSize": "text-xl",
                  "fontWeight": "font-bold",
                  "textColor": "{primitives.color.textPrimary}"
                }
              },
              {
                "id": "s-kpi-3",
                "type": "Text",
                "props": {
                  "text": "Resolved on First Contact"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "#059669"
                }
              }
            ]
          },
          {
            "id": "kpi-csat-score",
            "type": "Card",
            "style": {
              "flex": "1",
              "padding": "p-4",
              "backgroundColor": "{primitives.color.surface}"
            },
            "children": [
              {
                "id": "t-kpi-4",
                "type": "Text",
                "props": {
                  "text": "Customer Satisfaction (CSAT)"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "{primitives.color.textSecondary}"
                }
              },
              {
                "id": "v-kpi-4",
                "type": "Text",
                "props": {
                  "text": "4.92 / 5.0"
                },
                "style": {
                  "fontSize": "text-xl",
                  "fontWeight": "font-bold",
                  "textColor": "#059669"
                }
              },
              {
                "id": "s-kpi-4",
                "type": "Text",
                "props": {
                  "text": "Based on 480 Verified Ratings"
                },
                "style": {
                  "fontSize": "text-xs",
                  "textColor": "#059669"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "helpdesk-chart-section",
        "type": "Row",
        "style": {
          "gap": "gap-4"
        },
        "children": [
          {
            "id": "card-cat-chart",
            "type": "Card",
            "style": {
              "flex": "1",
              "padding": "p-4",
              "backgroundColor": "{primitives.color.surface}"
            },
            "children": [
              {
                "id": "t-chart-cat",
                "type": "Text",
                "props": {
                  "text": "Ticket Volume Distribution by Category"
                },
                "style": {
                  "fontSize": "text-sm",
                  "fontWeight": "font-semibold",
                  "textColor": "{primitives.color.textPrimary}"
                }
              },
              {
                "id": "chart-cat",
                "type": "Chart",
                "props": {
                  "type": "bar",
                  "data": "$data.ticketCategories"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "table-ticket-card",
        "type": "Card",
        "style": {
          "padding": "p-4",
          "backgroundColor": "{primitives.color.surface}"
        },
        "children": [
          {
            "id": "t-title-tickets",
            "type": "Text",
            "props": {
              "text": "Active Support Tickets & SLA Queue"
            },
            "style": {
              "fontSize": "text-sm",
              "fontWeight": "font-semibold",
              "textColor": "{primitives.color.textPrimary}"
            }
          },
          {
            "id": "grid-tickets",
            "type": "DataTable",
            "props": {
              "data": "$data.ticketQueue",
              "columns": [
                {
                  "key": "ticketId",
                  "label": "Ticket ID"
                },
                {
                  "key": "customer",
                  "label": "Customer / Organization"
                },
                {
                  "key": "subject",
                  "label": "Subject"
                },
                {
                  "key": "priority",
                  "label": "Priority"
                },
                {
                  "key": "channel",
                  "label": "Channel"
                },
                {
                  "key": "slaCountdown",
                  "label": "SLA Countdown"
                },
                {
                  "key": "assignee",
                  "label": "Assigned Agent"
                },
                {
                  "key": "status",
                  "label": "Status"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "table-canned-card",
        "type": "Card",
        "style": {
          "padding": "p-4",
          "backgroundColor": "{primitives.color.surface}"
        },
        "children": [
          {
            "id": "t-title-canned",
            "type": "Text",
            "props": {
              "text": "Top Knowledge Base & Canned Responses"
            },
            "style": {
              "fontSize": "text-sm",
              "fontWeight": "font-semibold",
              "textColor": "{primitives.color.textPrimary}"
            }
          },
          {
            "id": "grid-canned",
            "type": "DataTable",
            "props": {
              "data": "$data.cannedResponses",
              "columns": [
                {
                  "key": "code",
                  "label": "Article Code"
                },
                {
                  "key": "title",
                  "label": "Resolution Title"
                },
                {
                  "key": "category",
                  "label": "Module Category"
                },
                {
                  "key": "usage",
                  "label": "Usage Count"
                },
                {
                  "key": "effectivenessRating",
                  "label": "Effectiveness"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}

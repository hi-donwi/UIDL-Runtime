{
  "$schema": "https://uidl-runtime.local/schemas/document.json",
  "version": "1.0.0",
  "id": "helpdesk-console",
  "name": "CloudDesk Support Center Console",
  "theme": "theme-light",
  "dataSources": {
    "ticketCategories": [
      {
        "label": "Technical Bug",
        "value": 34
      },
      {
        "label": "Billing & Invoice",
        "value": 52
      },
      {
        "label": "How-To / Guidance",
        "value": 89
      },
      {
        "label": "Feature Request",
        "value": 21
      },
      {
        "label": "Access & Security",
        "value": 15
      }
    ],
    "ticketQueue": [
      {

{
  "$schema": "https://uidl-runtime.local/schemas/document.json",
  "version": "1.0.0",
  "id": "koperasi-bmt-console",
  "name": "Apex Credit Union & Community Banking Console",
  "theme": "default-light",
  "dataSources": {
    "savingsComposition": [
      {
        "label": "Core Member Shares",

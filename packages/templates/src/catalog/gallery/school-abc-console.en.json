{
  "$schema": "https://uidl-runtime.local/schemas/document.json",
  "version": "1.0.0",
  "id": "school-abc-console",
  "name": "Beacon Academy — Academic & Tuition Console",
  "theme": "theme-light",
  "dataSources": {
    "feeCollection": [
      {
        "label": "Jul",
        "value": 412000
      },
      {
        "label": "Aug",
        "value": 438000
      },
      {
        "label": "Sep",
        "value": 421000
      },
      {
        "label": "Oct",
        "value": 452000
      }
    ],
    "studentReceivables": [
      {
        "student": "Emma Watson",
        "class": "Grade 7A",
        "invoice": "FEE-2026-0821",
        "status": "Overdue",
        "outstanding": "$3,200"
      },
      {
        "student": "Liam Johnson",
        "class": "Grade 8B",
        "invoice": "FEE-2026-0822",
        "status": "Partially Paid",
        "outstanding": "$1,750"
      },
      {
        "student": "Sophia Miller",
        "class": "Grade 10 Science",
        "invoice": "FEE-2026-0823",
        "status": "Due This Week",
        "outstanding": "$4,500"
      }
    ],
    "financeControls": [
      {
        "module": "Student Fees",
        "control": "Student AR = Debtors - Tuition",
        "status": "Tied",
        "balance": "$218,450"
      },
      {
        "module": "Payroll",
        "control": "Salary Payable = Unpaid Payslips",
        "status": "Pending Approval",
        "balance": "$167,800"
      },
      {
        "module": "Budget",
        "control": "Program spend <= Approved budget",
        "status": "Warning",
        "balance": "82% used"
      },
      {
        "module": "Bank",
        "control": "Bank statement reconciled",
        "status": "3 unmatched",
        "balance": "$1.12M"
      }
    ],
    "ledger": [
      {
        "date": "2026-08-20",
        "account": "Accounts Receivable - Tuition",
        "debit": "$24,500",
        "credit": "$0",
        "voucher": "Fee Invoice"
      },
      {
        "date": "2026-08-20",
        "account": "Tuition Income",
        "debit": "$0",
        "credit": "$24,500",
        "voucher": "Fee Invoice"
      },
      {
        "date": "2026-08-20",
        "account": "Salary Expense",
        "debit": "$167,800",
        "credit": "$0",
        "voucher": "Payroll Run"
      },
      {
        "date": "2026-08-20",
        "account": "Salary Payable",
        "debit": "$0",
        "credit": "$167,800",
        "voucher": "Payroll Run"
      }
    ]
  },
  "definitions": {
    "pageHeader": {
      "id": "page-header-template",
      "type": "Navbar",
      "style": {
        "justifyContent": "space-between",
        "padding": "p-4",
        "borderWidth": "border-b",
        "borderColor": "{primitives.color.border}"
      },
      "slots": {
        "title": [],
        "actions": []
      }
    },
    "tableCard": {
      "id": "table-card-template",
      "type": "DataTable",
      "props": {
        "emptyMessage": "No records"
      },
      "style": {
        "width": "w-full"
      }
    },
    "chartCard": {
      "id": "chart-card-template",
      "type": "Chart",
      "props": {
        "chartType": "bar",
        "xKey": "label",
        "yKey": "value"
      },
      "style": {
        "width": "w-full"
      }
    }
  },
  "root": {
    "id": "school-console",
    "type": "Column",
    "style": {
      "gap": "gap-4",
      "padding": "p-4"
    },
    "children": [
      {
        "id": "school-header",
        "type": "Navbar",
        "componentId": "pageHeader",
        "slots": {
          "title": [
            {
              "id": "school-title",
              "type": "Text",
              "props": {
                "value": "Beacon Academy"
              },
              "style": {
                "fontSize": "text-2xl",
                "fontWeight": 700
              }
            }
          ],
          "actions": [
            {
              "id": "collect-fee",
              "type": "Button",
              "props": {
                "label": "Collect Fee"
              }
            },
            {
              "id": "payroll-run",
              "type": "Button",
              "props": {
                "label": "Run Payroll"
              }
            }
          ]
        }
      },
      {
        "id": "school-kpis",
        "type": "GridView",
        "style": {
          "display": "grid",
          "gap": "gap-3",
          "gridTemplateColumns": "repeat(auto-fit, minmax(180px, 1fr))"
        },
        "children": [
          {
            "id": "school-kpi-fee",
            "type": "Text",
            "props": {
              "value": "Fees Collected\n$438,000"
            },
            "style": {
              "padding": "p-4",
              "borderWidth": "border",
              "borderRadius": "rounded-lg",
              "background": "{primitives.color.surface}"
            }
          },
          {
            "id": "school-kpi-ar",
            "type": "Text",
            "props": {
              "value": "Student Receivables\n$218,450"
            },
            "style": {
              "padding": "p-4",
              "borderWidth": "border",
              "borderRadius": "rounded-lg",
              "background": "{primitives.color.surface}"
            }
          },
          {
            "id": "school-kpi-payroll",
            "type": "Text",
            "props": {
              "value": "Payroll Payable\n$167,800"
            },
            "style": {
              "padding": "p-4",
              "borderWidth": "border",
              "borderRadius": "rounded-lg",
              "background": "{primitives.color.surface}"
            }
          },
          {
            "id": "school-kpi-bank",
            "type": "Text",
            "props": {
              "value": "Bank Balance\n$1.12M"
            },
            "style": {
              "padding": "p-4",
              "borderWidth": "border",
              "borderRadius": "rounded-lg",
              "background": "{primitives.color.surface}"
            }
          }
        ]
      },
      {
        "id": "school-chart",
        "type": "Chart",
        "componentId": "chartCard",
        "props": {
          "title": "Tuition Fee Collection Trend",
          "chartType": "bar",
          "dataSource": "feeCollection"
        }
      },
      {
        "id": "school-ar",
        "type": "DataTable",
        "componentId": "tableCard",
        "props": {
          "title": "Student Receivables",
          "dataSource": "studentReceivables",
          "columns": [
            {
              "key": "student",
              "label": "Student Name"
            },
            {
              "key": "class",
              "label": "Class Grade"
            },
            {
              "key": "invoice",
              "label": "Invoice No."
            },
            {
              "key": "status",
              "label": "Status"
            },
            {
              "key": "outstanding",
              "label": "Outstanding",
              "align": "right"
            }
          ],
          "rowActions": [
            {
              "label": "Open"
            },
            {
              "label": "Send Reminder"
            }
          ]
        }
      },
      {
        "id": "school-controls",
        "type": "DataTable",
        "componentId": "tableCard",
        "props": {
          "title": "Institutional Financial Controls",
          "dataSource": "financeControls",
          "columns": [
            {
              "key": "module",
              "label": "Module"
            },
            {
              "key": "control",
              "label": "Control Assertion"
            },
            {
              "key": "status",
              "label": "Reconciliation Status"
            },
            {
              "key": "balance",
              "label": "Balance",
              "align": "right"
            }
          ]
        }
      },
      {
        "id": "school-ledger",
        "type": "DataTable",
        "componentId": "tableCard",
        "props": {
          "title": "General Ledger Balanced Posting Preview",
          "dataSource": "ledger",
          "columns": [
            {
              "key": "date",
              "label": "Date"
            },
            {
              "key": "account",
              "label": "Account"
            },
            {
              "key": "debit",
              "label": "Debit",
              "align": "right"
            },
            {
              "key": "credit",
              "label": "Credit",
              "align": "right"
            },
            {
              "key": "voucher",
              "label": "Voucher"
            }
          ]
        }
      }
    ]
  }
}

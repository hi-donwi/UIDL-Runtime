{
  "$schema": "https://uidl-runtime.local/schemas/document.json",
  "version": "1.0.0",
  "id": "document-proposal",
  "name": "Document Proposal Example",
  "route": "/examples/document-proposal",
  "definitions": {
    "docPage": {
      "id": "doc-page-template",
      "type": "Column",
      "style": { "width": "w-[820px]", "minHeight": "min-h-screen", "padding": "p-10", "backgroundColor": "bg-white", "gap": "gap-6", "shadow": "shadow-lg" },
      "slots": { "content": [] }
    },
    "callout": {
      "id": "callout-template",
      "type": "Column",
      "style": { "padding": "p-5", "borderRadius": "rounded-xl", "backgroundColor": "bg-accent-subtle", "gap": "gap-2" },
      "slots": { "content": [] }
    }
  },
  "root": {
    "id": "proposal-page",
    "type": "Container",
    "componentId": "docPage",
    "slots": {
      "content": [
        { "id": "doc-kicker", "type": "Text", "props": { "value": "Business Proposal" }, "style": { "color": "text-text-secondary", "fontSize": "text-sm" } },
        { "id": "doc-title", "type": "Text", "props": { "value": "AI-Generated Operations Portal" }, "style": { "fontSize": "text-4xl", "fontWeight": "font-bold", "color": "text-text-primary" } },
        { "id": "doc-summary", "type": "Text", "props": { "value": "This proposal demonstrates how uidl-runtime can compose long-form document pages with reusable sections, tables, callouts, and approval blocks from the same UIDL runtime used for websites and dashboards." }, "style": { "fontSize": "text-base", "color": "text-text-secondary" } },
        { "id": "summary-callout", "type": "Container", "componentId": "callout", "slots": { "content": [
          { "id": "callout-title", "type": "Text", "props": { "value": "Executive Summary" }, "style": { "fontWeight": "font-semibold" } },
          { "id": "callout-copy", "type": "Text", "props": { "value": "Deliver a schema-driven portal in phases: dashboard first, document automation second, export pipelines third." } }
        ] } },
        { "id": "scope-heading", "type": "Text", "props": { "value": "Scope Of Work" }, "style": { "fontSize": "text-2xl", "fontWeight": "font-semibold" } },
        { "id": "scope-table", "type": "DataTable", "props": { "title": "Implementation Plan", "dataSource": "milestones", "columns": [{ "key": "phase", "label": "Phase" }, { "key": "deliverable", "label": "Deliverable" }, { "key": "timeline", "label": "Timeline" }] } },
        { "id": "terms-heading", "type": "Text", "props": { "value": "Commercial Terms" }, "style": { "fontSize": "text-2xl", "fontWeight": "font-semibold" } },
        { "id": "terms-copy", "type": "Text", "props": { "value": "The schema can be generated by an AI agent, reviewed by product/design teams, and rendered by host projects with their own data, routing, theme, and authorization context." } },
        { "id": "signature-divider", "type": "Divider" },
        { "id": "signature-row", "type": "Row", "style": { "justifyContent": "space-between", "gap": "gap-6" }, "children": [
          { "id": "client-signature", "type": "Column", "children": [{ "id": "client-line", "type": "Divider" }, { "id": "client-label", "type": "Text", "props": { "value": "Client Approval" } }] },
          { "id": "vendor-signature", "type": "Column", "children": [{ "id": "vendor-line", "type": "Divider" }, { "id": "vendor-label", "type": "Text", "props": { "value": "Delivery Lead" } }] }
        ] }
      ]
    }
  },
  "dataSources": {
    "milestones": [
      { "phase": "1", "deliverable": "Dashboard runtime and RBAC navigation", "timeline": "2 weeks" },
      { "phase": "2", "deliverable": "Document and slide generation examples", "timeline": "2 weeks" },
      { "phase": "3", "deliverable": "Export and integration adapters", "timeline": "3 weeks" }
    ]
  }
}

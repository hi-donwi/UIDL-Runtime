  "definitions": {
    "pageHeader": {
      "id": "page-header-template",
      "type": "Navbar",
      "style": {
        "justifyContent": "space-between",
        "padding": "p-4",
        "borderWidth": "border-b",
        "borderColor": "{primitives.color.border}",
        "background": "{primitives.color.surface}"
      },
      "slots": { "title": [], "actions": [] }
    },
    "kpiCard": {
      "id": "kpi-card-template",
      "type": "Column",
      "style": {
        "padding": "p-4",
        "borderRadius": "rounded-lg",
        "borderWidth": "border",
        "borderColor": "{primitives.color.border}",
        "background": "{primitives.color.surface}",
        "gap": "gap-1"
      }
    }
  },
  "root": {
    "id": "koperasi-page",
    "type": "Column",
    "style": {
      "gap": "gap-6",
      "padding": "p-6",
      "background": "{primitives.color.background}",
      "minHeight": "min-h-screen"
    },
    "children": [
      {
        "id": "header",
        "type": "Navbar",
        "componentId": "pageHeader",
        "slots": {
          "title": [
            {
              "id": "title-text",
              "type": "Text",
              "props": { "value": "Koperasi & BMT Syariah Mandiri" },
              "style": { "fontSize": "text-2xl", "fontWeight": 700, "color": "{primitives.color.text-primary}" }
            },
            {
              "id": "subtitle-text",
              "type": "Text",
              "props": { "value": "Dashboard Pengawasan Simpan Pinjam Syariah, Alokasi SHU & Kepatuhan Pajak/BPJS" },
              "style": { "fontSize": "text-xs", "color": "{primitives.color.text-secondary}" }
            }
          ],
          "actions": [
            {
              "id": "btn-akad",
              "type": "Button",
              "props": { "label": "+ Akad Pembiayaan" },
              "style": { "padding": "p-2", "fontSize": "text-sm", "borderRadius": "rounded-md", "borderWidth": "border" }
            },
            {
              "id": "btn-shu",
              "type": "Button",
              "props": { "label": "Hitung SHU Anggota" },
              "style": { "padding": "p-2", "fontSize": "text-sm", "borderRadius": "rounded-md", "background": "{primitives.color.text-primary}", "color": "{primitives.color.background}" }
            }
          ]
        }
      },
      {
        "id": "kpi-grid",
        "type": "GridView",
        "style": {
          "display": "grid",
          "gridTemplateColumns": "repeat(auto-fit, minmax(220px, 1fr))",
          "gap": "gap-4"
        },
        "children": [
          {
            "id": "kpi-simpanan",
            "type": "Column",
            "componentId": "kpiCard",
            "children": [
              { "id": "kpi-lbl-1", "type": "Text", "props": { "value": "Total Dana Simpanan Anggota" }, "style": { "fontSize": "text-xs", "color": "{primitives.color.text-secondary}", "fontWeight": 600 } },
              { "id": "kpi-val-1", "type": "Text", "props": { "value": "Rp 4.820.000.000" }, "style": { "fontSize": "text-xl", "fontWeight": 700, "color": "{primitives.color.text-primary}" } },
              { "id": "kpi-sub-1", "type": "Text", "props": { "value": "1.240 Anggota Aktif" }, "style": { "fontSize": "text-xs", "color": "#10b981" } }
            ]
          },
          {
            "id": "kpi-pembiayaan",
            "type": "Column",
            "componentId": "kpiCard",
            "children": [
              { "id": "kpi-lbl-2", "type": "Text", "props": { "value": "Outstanding Pembiayaan (Murabahah)" }, "style": { "fontSize": "text-xs", "color": "{primitives.color.text-secondary}", "fontWeight": 600 } },
              { "id": "kpi-val-2", "type": "Text", "props": { "value": "Rp 6.450.000.000" }, "style": { "fontSize": "text-xl", "fontWeight": 700, "color": "{primitives.color.text-primary}" } },
              { "id": "kpi-sub-2", "type": "Text", "props": { "value": "FDR Rasio: 133.8%" }, "style": { "fontSize": "text-xs", "color": "{primitives.color.text-secondary}" } }
            ]
          },
          {
            "id": "kpi-npf",
            "type": "Column",
            "componentId": "kpiCard",
            "children": [
              { "id": "kpi-lbl-3", "type": "Text", "props": { "value": "Kolektibilitas / NPF Gross" }, "style": { "fontSize": "text-xs", "color": "{primitives.color.text-secondary}", "fontWeight": 600 } },
              { "id": "kpi-val-3", "type": "Text", "props": { "value": "1.42%" }, "style": { "fontSize": "text-xl", "fontWeight": 700, "color": "#10b981" } },
              { "id": "kpi-sub-3", "type": "Text", "props": { "value": "Kategori: Sangat Sehat (<5%)" }, "style": { "fontSize": "text-xs", "color": "#10b981" } }
            ]
          },
          {
            "id": "kpi-shu",
            "type": "Column",
            "componentId": "kpiCard",
            "children": [
              { "id": "kpi-lbl-4", "type": "Text", "props": { "value": "Estimasi SHU Tahun Berjalan" }, "style": { "fontSize": "text-xs", "color": "{primitives.color.text-secondary}", "fontWeight": 600 } },
              { "id": "kpi-val-4", "type": "Text", "props": { "value": "Rp 420.000.000" }, "style": { "fontSize": "text-xl", "fontWeight": 700, "color": "{primitives.color.accent}" } },
              { "id": "kpi-sub-4", "type": "Text", "props": { "value": "Siap RAT Des 2027" }, "style": { "fontSize": "text-xs", "color": "{primitives.color.accent}" } }
            ]
          }
        ]
      },
      {
        "id": "middle-grid",
        "type": "GridView",
        "style": {
          "display": "grid",
          "gridTemplateColumns": "1fr 1.4fr",
          "gap": "gap-6"
        },
        "children": [
          {
            "id": "chart-savings",
            "type": "Chart",
            "props": {
              "title": "Komposisi Dana Simpanan Anggota (Juta Rp)",
              "chartType": "donut",
              "dataSource": "savingsComposition",
              "xKey": "label",
              "yKey": "value"
            }
          },
          {
            "id": "tree-shu",
            "type": "TreeView",
            "props": {
              "title": "Struktur Hierarki Distribusi SHU Anggota Sesuai RAT",
              "dataSource": "shuDistributionTree"
            }
          }
        ]
      },
      {
        "id": "table-financing",
        "type": "DataTable",
        "props": {
          "title": "Akad Pembiayaan Anggota Aktif (Murabahah & Ijarah)",
          "dataSource": "financings",
          "columns": [
            { "key": "accountNo", "label": "No Akad" },
            { "key": "member", "label": "Nama Anggota" },
            { "key": "akad", "label": "Jenis Akad" },
            { "key": "object", "label": "Tujuan Pembiayaan" },
            { "key": "plafond", "label": "Plafond", "align": "right" },
            { "key": "margin", "label": "Margin BMT", "align": "right" },
            { "key": "tenor", "label": "Tenor" },
            { "key": "installment", "label": "Angsuran", "align": "right" },
            { "key": "status", "label": "Kolektibilitas" }
          ]
        }
      },
      {
        "id": "table-members",
        "type": "DataTable",
        "props": {
          "title": "Daftar Rekening Simpanan Anggota",
          "dataSource": "membersSavings",
          "columns": [
            { "key": "memberId", "label": "No Anggota" },
            { "key": "name", "label": "Nama Anggota" },
            { "key": "branch", "label": "Kantor Kas" },
            { "key": "simpananPokok", "label": "Simpanan Pokok", "align": "right" },
            { "key": "simpananWajib", "label": "Simpanan Wajib", "align": "right" },
            { "key": "simpananSukarela", "label": "Simpanan Sukarela", "align": "right" },
            { "key": "totalBalance", "label": "Total Saldo Simpanan", "align": "right" }
          ]
        }
      },
      {
        "id": "table-tax",
        "type": "DataTable",
        "props": {
          "title": "Kepatuhan Perpajakan DJP (e-Faktur PPN, PPh 21 TER) & BPJS Ketenagakerjaan/Kesehatan",
          "dataSource": "taxCompliance",
          "columns": [
            { "key": "taxItem", "label": "Kewajiban Perpajakan / Ketenagakerjaan" },
            { "key": "basis", "label": "Dasar Pengenaan / DPP" },
            { "key": "taxAmount", "label": "Nilai Pajak / Iuran", "align": "right" },
            { "key": "status", "label": "Status Pelaporan" },
            { "key": "dueDate", "label": "Jatuh Tempo" }
          ]
        }
      }
    ]
  }
}

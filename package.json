{
  "name": "uidl-runtime",
  "version": "0.1.13",
  "main": "./dist/uidl-runtime.js",
  "module": "./dist/uidl-runtime.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/uidl-runtime.mjs",
      "require": "./dist/uidl-runtime.js",
      "default": "./dist/uidl-runtime.mjs"
    },
    "./recipes": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/recipes.mjs",
      "require": "./dist/recipes.js",
      "default": "./dist/recipes.mjs"
    },
    "./style.css": "./dist/style.css",
    "./schema/*.json": "./dist/schema/*.json",
    "./catalog/*.json": "./dist/catalog/*.json"
  },
  "bin": {
    "uidl-validate": "bin/validate.mjs",
    "uidl-compile": "bin/compile.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm run dev:reference",
    "dev:core": "vite",
    "dev:reference": "vite --config apps/reference/vite.config.ts",
    "dev:workspace-control": "vite --config apps/workspace-control/vite.config.ts",
    "build:workspace-control": "vite build --config apps/workspace-control/vite.config.ts",
    "dev:reference:http": "VITE_DATA_MODE=http VITE_API_BASE_URL=http://127.0.0.1:8787/api vite --config apps/reference/vite.config.ts",
    "mock:api": "node scripts/mock-server.mjs",
    "build:reference": "vite build --config apps/reference/vite.config.ts",
    "preview:reference": "vite preview --config apps/reference/vite.config.ts",
    "build": "tsc -b && vite build && pnpm run build:css && pnpm run build:schema && pnpm run build:catalog",
    "build:css": "tailwindcss -i packages/core/src/style.css -o dist/style.css --minify",
    "build:schema": "node scripts/generate-json-schema.mjs",
    "export:themes": "tsx scripts/export-theme-presets.mts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "npm run build:css && playwright test --config playwright.layout.config.ts",
    "smoke:package": "pnpm run build && node scripts/smoke-package-consumer.mjs",
    "validate": "node bin/validate.mjs",
    "validate:examples": "node bin/validate.mjs packages/templates/src/documents/*.json packages/templates/src/catalog/gallery/*.en.json",
    "validate:spec": "node scripts/validate-spec.mjs",
    "audit:reference": "tsx scripts/audit-reference-coverage.mts",
    "bench:compilers": "tsx scripts/benchmark-compilers.mts",
    "test:reference": "playwright test e2e/real-reference-acceptance.spec.ts",
    "test:reference:visual": "playwright test e2e/visual-regression.spec.ts e2e/meridian-reference.spec.ts --grep \"visual baseline|matches its visual baseline\"",
    "test:reference:update": "playwright test e2e/visual-regression.spec.ts e2e/meridian-reference.spec.ts --grep \"visual baseline|matches its visual baseline\" --update-snapshots",
    "test:reference:http": "PLAYWRIGHT_DATA_MODE=http playwright test e2e/real-reference-acceptance.spec.ts",
    "build:catalog": "node scripts/build-catalog.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.4",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "description": "A schema-driven React runtime that renders validated JSON UIDL documents into lists, forms, reports and dashboards.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "keywords": [
    "uidl",
    "json-ui",
    "schema-driven-ui",
    "react",
    "low-code",
    "ui-runtime",
    "erp"
  ],
  "author": "donwi <hi.donwi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-donwi/UIDL-Runtime.git"
  },
  "homepage": "https://github.com/hi-donwi/UIDL-Runtime#readme",
  "bugs": {
    "url": "https://github.com/hi-donwi/UIDL-Runtime/issues"
  },
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@2.1.4": "2.1.7",
      "brace-expansion@5.0.9": "5.0.12",
      "fast-uri": "3.1.9",
      "source-map-js": "1.2.2",
      "undici": "8.12.3"
    }
  }
}
